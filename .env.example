# ─────────────────────────────────────────────────────
# BRUSS Dashboard – Environment Configuration
# Copy this file to .env and fill in your values
# NEVER commit .env to git (it's in .gitignore)
# ─────────────────────────────────────────────────────

# --- Dashboard ---
DASH_HOST=127.0.0.1
DASH_PORT=8050
DASH_DEBUG=True

# --- Data Source ---
# Options: "simulated" | "excel" | "sap_live"
DATA_SOURCE=excel
SAP_EXCEL_PATH=data/BRUSS_SAP_Dataset_Germany_CNC_REP_EN.xlsx

# --- Email Alerts ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your.email@gmail.com
SMTP_PASSWORD=your_app_password_here
ALERT_RECIPIENTS=maintenance.lead@bruss.de,engineer@bruss.de

# --- ML Model ---
MODEL_PATH=models/failure_model.pkl
RETRAIN_ON_STARTUP=False
FAILURE_THRESHOLD=0.75
